#!/bin/sh
# The opener GNUstep reaches for, inside the AppImage (from HomeRow's).
#
# NSWorkspace hands a URL or a path to whatever [NSTask launchPathForTool:]
# finds -- the GSUnknownFileTool default, or "xdg-open" as its built-in
# fallback (NSWorkspace.m:_openUnknown:). That lookup searches GNUstep's own
# tool directories BEFORE $PATH (NSTask+GNUstepBase.m:launchPathForTool:), and
# in the image those directories are inside the bundle, where no opener lives.
# So this is installed there under both names, and it hands the job to the
# host.
#
# It also puts the environment back before doing so. AppRun points
# LD_LIBRARY_PATH and PATH at the libraries the image carries; a browser
# started with those inherits them and dies on a symbol it did not expect. The
# values from before the image started are what a host program needs.
set -eu

[ $# -gt 0 ] || { echo "usage: open <url-or-file>" >&2; exit 2; }

# Restored from what AppRun saved; empty is a legitimate value for both, and
# means "unset it".
if [ -n "${UD_HOST_LD_LIBRARY_PATH:-}" ]; then
    LD_LIBRARY_PATH="$UD_HOST_LD_LIBRARY_PATH"
    export LD_LIBRARY_PATH
else
    unset LD_LIBRARY_PATH || true
fi
host_path="${UD_HOST_PATH:-/usr/local/bin:/usr/bin:/bin}"
PATH="$host_path"
export PATH

# In the order a Linux desktop expects. `gio open` covers a GNOME session with
# no xdg-utils installed; the browser variables are the last resort for a URL.
for tool in xdg-open gio gnome-open kde-open5 kde-open exo-open; do
    found=""
    IFS=:
    for dir in $host_path; do
        [ -n "$dir" ] || continue
        if [ -x "$dir/$tool" ]; then found="$dir/$tool"; break; fi
    done
    unset IFS
    [ -n "$found" ] || continue
    if [ "$tool" = gio ]; then
        exec "$found" open "$@"
    fi
    exec "$found" "$@"
done

if [ -n "${BROWSER:-}" ]; then
    exec "$BROWSER" "$@"
fi

echo "open: no xdg-open, gio or browser on the host to hand '$1' to" >&2
exit 1
