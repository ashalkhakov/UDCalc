# What UDCalc's release builds on, each at a commit: the only place these
# are named. release.yml reads this file (gnustep-release-actions' pins
# action). To move one, change it here.

# gnustep-patches, the patched GNUstep stack the AppImage is built on (the
# commit TopoText releases with). Tests/gershwin-dev builds Gershwin's
# unstable desktop instead, and picks its own commit for that.
GNUSTEP_PATCHES_REF=dcbad8f6db6db7054bc9152aad3e8686a233809d
