# What UDCalc's release builds on, each at a commit: the only place these
# are named. release.yml reads this file (gnustep-release-actions' pins
# action). To move one, change it here.

# gnustep-patches, the patched GNUstep stack the AppImage is built on (the
# commit every app builds on). 7adc606 (#12): arc4random() and its
# companions on glibc before 2.36 (Ubuntu 22.04's 2.35), which the
# calculator calls. Tests/gershwin-dev builds Gershwin's unstable desktop
# instead, and picks its own commit for that.
GNUSTEP_PATCHES_REF=7adc606d3ff7059f5099d2c4b798dd3a54bac075
