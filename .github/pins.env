# What UDCalc builds on, by the exact versions of their releases:
# gnustep-release-actions' workflows (scripts/deps.sh) fetch them from here.
# To move one, edit it here.
#   Linux  the GNUstep stack's archive, unpacked into /opt/gnustep
#   Apple  Sparkle's XCFramework, unpacked into .deps/

# The patched GNUstep stack (ashalkhakov/gnustep-patches).
GNUSTEP_PATCHES_VERSION=2026.10.13.1
# UDCalc's updates on macOS.
SPARKLE_VERSION=2.10.0
